# Copie para .env e preencha com os MESMOS valores do VinaCare (mesma conta Oracle).
# NUNCA suba o .env para o GitHub.
OCI_USER=ocid1.user.oc1..
OCI_FINGERPRINT=aa:bb:cc:...
OCI_TENANCY=ocid1.tenancy.oc1..
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..
# A chave privada: use UMA das duas opcoes
OCI_KEY_B64=
OCI_KEY_CONTENT=
# Voz neural (opcional, igual ao VinaCare)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# Pastas
STUDENTMEDICAL_DATA_DIR=./data
# biblioteca.db gerada por ml/indexar_livros.py (padrao: data/biblioteca.db)
SM_BIBLIOTECA=
SM_ORIGENS=http://localhost:8000,http://localhost:5500,https://leonardogmendoza.github.io
